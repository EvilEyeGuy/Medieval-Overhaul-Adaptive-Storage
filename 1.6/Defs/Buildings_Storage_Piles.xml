<Defs>

	<ThingDef ParentName="DankPyon_StorageBase">
		<defName>EEG_OrePileSquare</defName>
		<label>ore pile (2x2)</label>
		<description>A marked patch of ground where raw ore and coal are heaped into a pile.</description>
		<designationCategory Inherit="False">EEG_MOxASFStorage</designationCategory>
		<researchPrerequisites Inherit="false"/>
		<graphicData>
			<texPath>Things/Building/Storage/Brick2x2Empty</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
			<drawRotated>false</drawRotated>
		</graphicData>
		<uiIconPath>Things/Item/Resource/IronOre/IronOre_c</uiIconPath>
		<size>(2,2)</size>
		<rotatable>false</rotatable>
		<castEdgeShadows>false</castEdgeShadows>
		<staticSunShadowHeight>0</staticSunShadowHeight>
		<passability>Standable</passability>
		<pathCost>14</pathCost>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>0</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>0</Beauty>
		</statBases>
		<building>
			<maxItemsInCell>6</maxItemsInCell>
			<fixedStorageSettings Inherit="false">
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<thingDefs>
						<li>DankPyon_Coal</li>
					</thingDefs>
					<categories>
						<li>DankPyon_RawOres</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings Inherit="False">
				<priority>Preferred</priority>
				<filter>
					<thingDefs>
						<li>DankPyon_Coal</li>
					</thingDefs>
					<categories>
						<li>DankPyon_RawOres</li>
					</categories>
				</filter>
			</defaultStorageSettings>
		</building>
		<modExtensions>
			<li Class="AdaptiveStorage.Extension">
				<labelFormat>NoStuff</labelFormat>
			</li>
		</modExtensions>
		<drawGUIOverlay>True</drawGUIOverlay>
		<minifiedDef />
		<thingCategories Inherit="False" />
	</ThingDef>

