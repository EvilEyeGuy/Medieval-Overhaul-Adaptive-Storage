			<drawSize>(2,2)</drawSize>
		</graphicData>
		<uiIconPath>Things/Item/Resource/Bone/Bone_c</uiIconPath>
		<size>(2,2)</size>
		<rotatable>false</rotatable>
		<castEdgeShadows>false</castEdgeShadows>
		<staticSunShadowHeight>0</staticSunShadowHeight>
		<passability>Standable</passability>
		<pathCost>14</pathCost>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>0</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>0</Beauty>
		</statBases>
		<building>
			<maxItemsInCell>2</maxItemsInCell>
			<fixedStorageSettings Inherit="false">
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Corpses</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings Inherit="False">
				<priority>Normal</priority>
				<filter>
					<categories>
						<li>Corpses</li>
					</categories>
				</filter>
			</defaultStorageSettings>
		</building>
		<comps>
			<li Class="MedievalOverhaulAdaptiveStorage.CompProperties_CorpsePile" />
		</comps>
		<modExtensions>
			<li Class="AdaptiveStorage.Extension">
				<labelFormat>NoStuff</labelFormat>
			</li>
		</modExtensions>
		<drawGUIOverlay>True</drawGUIOverlay>
		<minifiedDef />
		<thingCategories Inherit="False" />
