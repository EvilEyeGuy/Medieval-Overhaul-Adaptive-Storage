<Defs>

	<ThingDef ParentName="DankPyon_StorageBase">
		<defName>EEG_CorpsePileSquare</defName>
		<drawerType>MapMeshAndRealTime</drawerType>
		<label>corpse pile (2x2)</label>
		<description>A marked patch of ground where corpses are heaped up. A colonist can set the pile on fire to burn the corpses. The fire can spread to anything nearby.</description>
		<designationCategory Inherit="False">EEG_MOxASFStorage</designationCategory>
		<researchPrerequisites Inherit="false"/>
